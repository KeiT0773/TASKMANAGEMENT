# terraform.tfvars の記入例。次のコマンドで複写して使う（手順書 6.1 (1)）。
#   cp infra/terraform/terraform.tfvars.example infra/terraform/terraform.tfvars
# 再開・更新のスクリプト（infra/scripts/）は、これらの値を自動で書き換える。

# ECS で動かすイメージのタグ（Git のコミットの短縮ハッシュ。例："275fbd7"）
backend_image_tag = ""

# DB を復元するスナップショットの名前。空なら DB を新規に作る（例："taskmanagement-20261017-2130"）
db_snapshot_identifier = ""

# アクセスを許可する自宅の IPv6 のネットワーク番号（先頭 64 ビット）。インフラ設計書 6.5
# startup.sh / update-allowed-ip.sh が、その時点の PC の IPv6 アドレスから自動で書く（例：["240d:1a:9e6:8c00::/64"]）
allowed_viewer_ipv6_prefixes = []
